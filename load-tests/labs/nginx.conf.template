worker_rlimit_nofile 32768;
events { worker_connections 16384; }
http {
  access_log off;
  upstream snapshot { server ${SNAPSHOT_UPSTREAM}; keepalive 128; }
  upstream principal { server api:3000; keepalive 32; }
  server {
    listen 8080;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    proxy_buffering off;
    location = /healthz { proxy_pass http://snapshot; }
    location ~ ^/v1/field/(blocks/[^/]+/sync/?|sync/?|session/?)$ { proxy_pass http://snapshot; }
    location / { proxy_pass http://principal; }
  }
}
