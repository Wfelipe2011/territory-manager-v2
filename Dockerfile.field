FROM node:20 AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --quiet
COPY prisma ./prisma
RUN npx prisma generate
COPY nest-cli.json tsconfig*.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev --ignore-scripts

FROM node:20 AS worker-dependencies
WORKDIR /dependencies
COPY field-worker/package.json field-worker/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM oven/bun:1.3.14-slim@sha256:d56a2534ffd262e92c12fd3249d3924d296d97086da773f821d7d0477435ea04
WORKDIR /app
ENV NODE_ENV=production TZ=America/Sao_Paulo PORT=3402
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=worker-dependencies /dependencies/node_modules ./field-worker/node_modules
COPY views ./views
COPY field-worker ./field-worker
USER bun
EXPOSE 3402
CMD ["bun", "/app/field-worker/main.cjs"]
