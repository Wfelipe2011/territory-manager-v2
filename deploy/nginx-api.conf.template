# Opt-in production upstream behind Nginx Proxy Manager. No host ports published.
map $http_x_forwarded_proto $territory_forwarded_proto {
    default $scheme;
    http http;
    https https;
}
upstream field_sync {
    server ${FIELD_SYNC_UPSTREAM};
    keepalive 128;
}
upstream principal {
    server app-prod:3000;
    keepalive 32;
}
server {
    listen 8080;
    client_max_body_size 10m;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $territory_forwarded_proto;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    proxy_buffering off;
    proxy_cache off;
    proxy_next_upstream off;
    location = /healthz {
        add_header X-Territory-Upstream field-worker always;
        proxy_pass http://field_sync;
    }
    location ~ ^/v1/field/(blocks/[^/]+/sync/?|sync/?|session/?)$ {
        add_header X-Territory-Upstream field-worker always;
        proxy_pass http://field_sync;
    }
    location / {
        add_header X-Territory-Upstream api always;
        proxy_pass http://principal;
    }
}
