generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

// OAuth artifacts are encrypted; identifiers are SHA-256 digests, never bearer tokens.
model agent_oauth_artifact {
  key String @id
  model String
  payload String
  grantId String?
  uid String? @unique
  userCode String? @unique
  consumedAt Int?
  expiresAt DateTime
  @@index([grantId])
  @@index([expiresAt])
}

model agent_connection {
  id String @id
  userId Int
  tenantId Int
  clientId String
  clientName String
  credentialVersion String
  scopes String[]
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  @@index([tenantId, userId])
}

model agent_operation {
  connectionId String
  key String
  requestHash String
  result Json
  expiresAt DateTime
  @@id([connectionId, key])
  @@index([expiresAt])
}

model agent_audit {
  id Int @id @default(autoincrement())
  tenantId Int
  userId Int
  clientId String
  connectionId String
  tool String
  recordId Int?
  outcome String
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
}

model agent_rate_limit {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

model address {
  id   Int    @id @unique @default(autoincrement())
  name String

  // Relacionamentos
  houses                  house[]
  multitenancy            multitenancy              @relation(fields: [tenantId], references: [id])
  tenantId                Int                       @map("tenant_id")
  zipCode                 String?                   @map("zip_code")
  // Relacionamentos
  territory_block_address territory_block_address[]
}

model type {
  id           Int          @id @unique @default(autoincrement())
  name         String
  multitenancy multitenancy @relation(fields: [tenantId], references: [id])
  tenantId     Int          @map("tenant_id")

  // Relacionamentos
  territory territory[]
}

model block {
  id           Int          @id @unique @default(autoincrement())
  name         String
  multitenancy multitenancy @relation(fields: [tenantId], references: [id])
  tenantId     Int          @map("tenant_id")

  // Relacionamentos
  houses          house[]
  territory_block territory_block[]
  round           round[]
}

enum ReportType {
  add
  remove
  update
}

model house {
  registrationStatus RegistrationStatus @default(approved) @map("registration_status")
  id                      Int       @id @unique @default(autoincrement())
  number                  String
  dontVisit               Boolean   @default(false) @map("dont_visit")
  block                   block     @relation(fields: [blockId], references: [id])
  blockId                 Int       @map("block_id") /// @deprecated Use `territoryBlockAddressId` instead.
  address                 address   @relation(fields: [addressId], references: [id])
  addressId               Int       @map("address_id") /// @deprecated Use `territoryBlockAddressId` instead.
  territory               territory @relation(fields: [territoryId], references: [id])
  territoryId             Int       @map("territory_id") /// @deprecated Use `territoryBlockAddressId` instead.
  territoryBlockAddressId Int?      @map("territory_block_address_id")

  phone        String?
  legend       String?
  complement   String?
  order        Int?
  observations String?
  reportType   ReportType? @map("report_type")
  backupData   Json?       @map("backup_data")

  // Relacionamentos
  rounds                round[]
  multitenancy          multitenancy             @relation(fields: [tenantId], references: [id])
  tenantId              Int                      @map("tenant_id")
  territoryBlockAddress territory_block_address? @relation(fields: [territoryBlockAddressId], references: [id])

  @@index([tenantId])
  @@index([territoryId, blockId, addressId])
  @@index([territoryBlockAddressId])
}

model firebase {
  id     Int  @id @unique @default(autoincrement())
  config Json
}

model multitenancy {
  requestsRevision BigInt @default(0) @map("requests_revision")
  changeRequests change_request[]
  id    Int     @id @unique @default(autoincrement())
  name  String
  phone String?
  city  String  @default("Sorocaba")
  state String  @default("SP")

  // Relacionamentos
  users                   user[]
  territories             territory[]
  addresses               address[]
  blocks                  block[]
  houses                  house[]
  round                   round[]
  type                    type[]
  territory_block         territory_block[]
  territory_overseer      territory_overseer[]
  signature               signature[]
  territory_block_address territory_block_address[]
  parameters              parameter[]
  financial_entries       financial_entry[]
  socket                  socket[]

  @@map("multi_tenancy")
}

model parameter {
  id           Int          @id @unique @default(autoincrement())
  key          String
  value        String
  description  String?
  multitenancy multitenancy @relation(fields: [tenantId], references: [id])
  tenantId     Int          @map("tenant_id")

  @@unique([tenantId, key])
  @@map("parameter")
}

model territory {
  id           Int          @id @unique @default(autoincrement())
  name         String
  multitenancy multitenancy @relation(fields: [tenantId], references: [id])
  tenantId     Int          @map("tenant_id")
  type         type         @relation(fields: [typeId], references: [id])
  typeId       Int          @map("type_id")
  imageUrl     String?      @map("image_url")

  // Relacionamentos
  house              house[]
  round              round[]
  territory_block    territory_block[]
  territory_overseer territory_overseer[]
}

model territory_block {
  registrationStatus RegistrationStatus @default(approved) @map("registration_status")
  id                      Int                       @id @unique @default(autoincrement())
  block                   block                     @relation(fields: [blockId], references: [id])
  blockId                 Int                       @map("block_id")
  territory               territory                 @relation(fields: [territoryId], references: [id])
  territoryId             Int                       @map("territory_id")
  signature               signature?                @relation(fields: [signatureId], references: [id])
  signatureId             Int?                      @map("signature_id")
  multitenancy            multitenancy              @relation(fields: [tenantId], references: [id])
  tenantId                Int                       @map("tenant_id")
  territory_block_address territory_block_address[]

  @@unique([territoryId, blockId]) // Adicionando a anotação para criar a chave composta
  @@index([tenantId])
}

model territory_block_address {
  registrationStatus RegistrationStatus @default(approved) @map("registration_status")
  id               Int             @id @unique @default(autoincrement())
  territoryBlock   territory_block @relation(fields: [territoryBlockId], references: [id])
  territoryBlockId Int             @map("territory_block_id")
  address          address         @relation(fields: [addressId], references: [id])
  addressId        Int             @map("address_id")
  multitenancy     multitenancy    @relation(fields: [tenantId], references: [id])
  tenantId         Int             @map("tenant_id")
  house            house[]

  @@unique([territoryBlockId, addressId]) // Adicionando a anotação para criar a chave composta
  @@index([tenantId])
}

model territory_overseer {
  id             Int          @id @unique @default(autoincrement())
  territory      territory    @relation(fields: [territoryId], references: [id])
  territoryId    Int          @map("territory_id")
  overseer       String
  initialDate    DateTime     @default(now()) @map("initial_date")
  expirationDate DateTime?    @map("expiration_date")
  finished       Boolean      @default(false)
  signature      signature?   @relation(fields: [signatureId], references: [id])
  signatureId    Int?         @map("signature_id")
  multitenancy   multitenancy @relation(fields: [tenantId], references: [id])
  tenantId       Int          @map("tenant_id")
  roundNumber    Int?         @map("round_number")

  @@index([territoryId, roundNumber])
}

model round_info {
  status RoundStatus @default(open)
  typeIds Int[] @default([]) @map("type_ids")
  startedAt DateTime? @default(now()) @map("started_at")
  closedAt DateTime? @map("closed_at")
  id             Int       @id @unique @default(autoincrement())
  roundNumber    Int       @map("round_number")
  name           String
  theme          ThemeMode
  tenantId       Int       @map("tenant_id")
  colorPrimary   String?   @map("color_primary")
  colorSecondary String?   @map("color_secondary")
  type           String    @default("Residencial")

  // index unico: tenantId, roundNumber
  @@unique([tenantId, roundNumber]) // Adicionando a anotação para criar a chave composta
}

// index unico: houseId, territoryId, blockId, tenantId, roundNumber
model round {
  id          Int @id @unique @default(autoincrement())
  roundNumber Int @map("round_number")

  // Relacionamentos
  house       house     @relation(fields: [houseId], references: [id])
  houseId     Int       @map("house_id")
  territory   territory @relation(fields: [territoryId], references: [id])
  territoryId Int       @map("territory_id")
  block       block     @relation(fields: [blockId], references: [id])
  blockId     Int       @map("block_id")

  completed     Boolean
  startDate     DateTime  @default(now()) @map("start_date")
  updateDate    DateTime? @map("update_date")
  completedDate DateTime? @map("completed_date")
  endDate       DateTime? @map("end_date")

  multitenancy multitenancy @relation(fields: [tenantId], references: [id])
  tenantId     Int          @map("tenant_id")
  mode         ThemeMode    @default(default)
  leaveLetter  Boolean      @default(false) @map("leave_letter")

  @@unique([houseId, territoryId, blockId, tenantId, roundNumber]) // Adicionando a anotação para criar a chave composta
  @@index([houseId, roundNumber])
  @@index([tenantId])
}

enum ThemeMode {
  default
  campaign
  letters
}

model user {
  id           Int          @id @unique @default(autoincrement())
  name         String
  email        String       @unique
  password     String
  multitenancy multitenancy @relation(fields: [tenantId], references: [id])
  tenantId     Int          @map("tenant_id")
}

model signature {
  canEditStructure Boolean @default(false) @map("can_edit_structure")
  id             Int          @id @unique @default(autoincrement())
  key            String       @unique
  expirationDate DateTime?    @map("expiration_date")
  token          String
  multitenancy   multitenancy @relation(fields: [tenantId], references: [id])
  tenantId       Int          @map("tenant_id")

  // Relacionamentos
  territory_block    territory_block[]
  territory_overseer territory_overseer[]
  socket             socket[]
}

model socket {
  id             Int          @id @unique @default(autoincrement())
  socketId       String       @unique
  room           String
  createdAt      DateTime     @default(now()) @map("created_at")
  disconnectedAt DateTime?    @map("disconnected_at")
  signatureKey   String?      @map("signature_key")
  tenantId       Int          @map("tenant_id")
  signature      signature?   @relation(fields: [signatureKey], references: [key])
  multitenancy   multitenancy @relation(fields: [tenantId], references: [id])

  @@index([createdAt])
  @@index([tenantId, createdAt])
}

// Revision updates are enforced by SQL triggers, including bulk/admin changes.
model field_revision {
  tenantId    Int    @map("tenant_id")
  territoryId Int    @map("territory_id")
  roundNumber Int    @map("round_number")
  blockId     Int    @default(0) @map("block_id")
  revision    BigInt @default(1)

  @@id([tenantId, territoryId, roundNumber, blockId])
}

// Derived, disposable raw catalogs. No signature tokens or authorization decisions.
model field_read_model {
  tenantId    Int      @map("tenant_id")
  territoryId Int      @map("territory_id")
  blockId     Int      @map("block_id")
  roundNumber Int      @map("round_number")
  revision    String
  payload     Json
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, territoryId, blockId, roundNumber, revision])
  @@index([updatedAt], map: "field_read_model_updated_at_idx")
}

model field_session {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @map("tenant_id")
  territoryId    Int       @map("territory_id")
  roundNumber    Int       @map("round_number")
  blockId        Int?      @map("block_id")
  addressId      Int?      @map("address_id")
  clientId       String    @map("client_id")
  tabId          String    @map("tab_id")
  signatureKey   String    @map("signature_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  disconnectedAt DateTime? @map("disconnected_at") @db.Timestamptz(6)

  // Partial unique index for OPEN sessions is maintained in the SQL migration.
  @@index([tenantId, territoryId, roundNumber, lastSeenAt], map: "field_session_presence_idx")
  @@index([createdAt], map: "field_session_history_idx")
}

// Aggregate analytics only: scopeId=0 is global; others are tenant IDs.
model field_concurrency_sample {
  sampledAt DateTime @map("sampled_at") @db.Timestamptz(6)
  scopeId   Int      @map("scope_id")
  active    Int
  @@id([sampledAt, scopeId])
}

model field_concurrency_hour {
  bucketAt  DateTime @map("bucket_at") @db.Timestamptz(6)
  scopeId   Int      @map("scope_id")
  samples   Int
  activeSum BigInt   @map("active_sum")
  peak      Int
  peakAt    DateTime @map("peak_at") @db.Timestamptz(6)
  @@id([bucketAt, scopeId])
  @@index([scopeId, bucketAt], map: "field_concurrency_hour_scope_idx")
}

model request_metric_minute {
  bucketAt DateTime @map("bucket_at") @db.Timestamptz(6)
  component String
  instanceId String @map("instance_id")
  category String
  requests Int
  errors Int
  clientErrors Int @map("client_errors")
  aborted Int
  totalMs Float @map("total_ms")
  maxMs Float @map("max_ms")
  histogram Int[]
  revision Int
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@id([bucketAt, component, instanceId, category])
}

model paypal_transaction {
  id                      Int      @id @unique @default(autoincrement())
  transactionId           String   @unique // ID da transação do PayPal
  date                    DateTime // Data da transação
  time                    String // Horário da transação
  timezone                String // Fuso horário
  description             String? // Descrição da transação
  currency                String // Moeda usada
  grossAmount             Float // Valor bruto
  feeAmount               Float // Tarifa
  netAmount               Float // Valor líquido
  balanceAfterTransaction Float? // Saldo após a transação
  emailFrom               String? // Email do remetente
  name                    String? // Nome do remetente
  bankName                String? // Nome do banco
  bankAccount             String? // Conta bancária
  shippingAmount          Float? // Valor do frete
  salesTax                Float? // Imposto sobre vendas
  invoiceId               String? // ID da fatura
  referenceTransactionId  String? // ID de referência da transação

  createdAt DateTime @default(now()) // Data de criação do registro
  updatedAt DateTime @updatedAt // Atualizado automaticamente
}

enum FinancialEntryType {
  POSITIVE
  NEGATIVE
}

model financial_entry {
  id           Int                @id @unique @default(autoincrement())
  tenantId     Int                @map("tenant_id")
  multitenancy multitenancy       @relation(fields: [tenantId], references: [id])
  
  description  String?
  value        Float
  date         DateTime
  cycle        Int
  type         FinancialEntryType
  
  donorName    String?            @map("donor_name")
  externalId   String?            @unique @map("external_id")

  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([tenantId, cycle])
}



enum RegistrationStatus {
  pending
  approved
  rejected
}
enum RoundStatus {
  open
  closed
  uninitialized
}
enum ChangeEntity {
  house
  street
  block
}
enum ChangeAction {
  create
  update
  delete
}
enum ChangeStatus {
  pending
  approved
  rejected
}

model change_request {
  id Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  multitenancy multitenancy @relation(fields: [tenantId], references: [id])
  entity ChangeEntity
  action ChangeAction
  status ChangeStatus @default(pending)
  territoryId Int @map("territory_id")
  blockId Int? @map("block_id")
  addressId Int? @map("address_id")
  targetId Int? @map("target_id")
  parentRequestId Int? @map("parent_request_id")
  parent change_request? @relation("RequestTree", fields: [parentRequestId], references: [id], onDelete: Restrict)
  children change_request[] @relation("RequestTree")
  beforeData Json? @map("before_data")
  proposedData Json @map("proposed_data")
  observations String
  requestedByUserId Int? @map("requested_by_user_id")
  requestedByName String? @map("requested_by_name")
  sourceSignatureKey String? @map("source_signature_key")
  requestedAt DateTime? @default(now()) @map("requested_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version Int @default(1)
  reviewedAt DateTime? @map("reviewed_at")
  reviewerId Int? @map("reviewer_id")
  reviewReason String? @map("review_reason")
  isLegacy Boolean @default(false) @map("is_legacy")
  legacyHouseId Int? @unique @map("legacy_house_id")
  importedAt DateTime? @map("imported_at")
  history Json @default("[]")

  @@index([tenantId, status, updatedAt])
  @@index([tenantId, territoryId, blockId])
  @@index([tenantId, entity, targetId])
  @@index([parentRequestId])
}
